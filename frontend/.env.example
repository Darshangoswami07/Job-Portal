# Backend API base URL (no trailing slash). Only one of these needs to be
# set — constant.js checks them in this order. Falls back to
# http://localhost:8000 in dev / the deployed Render URL in prod if none set.
#
# This .env file is for LOCAL DEV ONLY — keep it pointed at localhost.
# For the deployed site, set VITE_API_URL in the Vercel dashboard
# (Project → Settings → Environment Variables) to the live Render URL,
# e.g. https://job-portal-backend-o9lb.onrender.com. Vercel does not read
# this file in production, so this value never needs to change here.
VITE_API_URL=http://localhost:8000
# VITE_BACKEND_URL=
# VITE_SERVER_URL=
# VITE_BACKEND_BASE_URL=

# NOTE: Google OAuth client ID/secret do NOT belong here. The whole OAuth
# handshake is server-side (backend/config/passport.js) — the frontend only
# links to `${VITE_API_URL}/api/v1/user/google`. Anything prefixed VITE_ is
# bundled into the shipped JS and readable by anyone, so a client secret
# here would leak publicly. Configure Google credentials in backend/.env
# only (see backend/.env.example).
