# --- Database ---
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>

# --- Server ---
# This .env file is for LOCAL DEV ONLY. For the deployed backend (Render),
# set these same variable names in the Render dashboard
# (Service → Environment) with production values instead of editing this
# file — Render does not read this file, it reads its own dashboard env vars.
PORT=8000
NODE_ENV=development
# Local: http://localhost:5173
# Render dashboard (production): https://job-portal-kappa-nine.vercel.app
FRONTEND_URL=http://localhost:5173

# --- Auth ---
# Any long random string. Used to sign short-lived access tokens.
SECRET_KEY=change-me
# A DIFFERENT long random string. Used to sign refresh tokens so a leaked
# access token can't be replayed as a refresh token. Falls back to
# `${SECRET_KEY}_refresh` if unset, but set your own in production.
REFRESH_SECRET_KEY=change-me-too
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
SESSION_SECRET=change-me-session

# --- Cloudinary (resume/photo uploads) ---
CLOUD_NAME=
API_KEY=
API_SECRET=

# --- OAuth (optional, login falls back to email/password if unset) ---
# GOOGLE_CALLBACK_URL usually doesn't need to be set explicitly — it falls
# back to `${backendUrl}/api/v1/user/google/callback`, where backendUrl
# resolves via runtimeUrls.js: localhost:8000 in local dev, or Render's
# auto-set RENDER_EXTERNAL_URL in production. Only set it if you need to
# override that. Whatever URL is actually used (local or production) must
# also be registered as an authorized redirect URI in the Google Cloud
# Console OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=

# --- Job aggregation (optional) ---
# The app works fine without any of these — job aggregation is skipped and
# the app relies on locally seeded/posted jobs instead.
#
# Adzuna: register a free app at https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
#
# JSearch (via RapidAPI): subscribe at
# https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=
#
# Jooble: request a free API key at https://jooble.org/api/about
JOOBLE_API_KEY=

# --- Debugging ---
DEBUG_PROFILE_UPDATE=false
